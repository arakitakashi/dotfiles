# Claude の permissions から移植したグローバルコマンドルール。
# 引数の前方一致。詳細と移植できない項目は ../permissions.md を参照。

prefix_rule(pattern = ["git","commit"], decision = "allow")
prefix_rule(pattern = ["git","checkout"], decision = "allow")
prefix_rule(pattern = ["git","stash"], decision = "allow")
prefix_rule(pattern = ["git","rev-parse"], decision = "allow")
prefix_rule(pattern = ["git","remote"], decision = "allow")
prefix_rule(pattern = ["uv","add"], decision = "allow")
prefix_rule(pattern = ["uv","remove"], decision = "allow")
prefix_rule(pattern = ["uv","sync"], decision = "allow")
prefix_rule(pattern = ["uv","lock"], decision = "allow")
prefix_rule(pattern = ["uv","pip","list"], decision = "allow")
prefix_rule(pattern = ["uv","run","ruff"], decision = "allow")
prefix_rule(pattern = ["uv","run","pytest"], decision = "allow")
prefix_rule(pattern = ["uv","run","pyright"], decision = "allow")
prefix_rule(pattern = ["uvx","ruff"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["gh","pr","view"], decision = "allow")
prefix_rule(pattern = ["gh","pr","diff"], decision = "allow")
prefix_rule(pattern = ["gh","pr","list"], decision = "allow")
prefix_rule(pattern = ["gh","pr","status"], decision = "allow")
prefix_rule(pattern = ["gh","pr","checks"], decision = "allow")
prefix_rule(pattern = ["gh","issue","view"], decision = "allow")
prefix_rule(pattern = ["gh","issue","list"], decision = "allow")
prefix_rule(pattern = ["gh","repo","view"], decision = "allow")
prefix_rule(pattern = ["gh","repo","list"], decision = "allow")
prefix_rule(pattern = ["gh","run","view"], decision = "allow")
prefix_rule(pattern = ["gh","run","list"], decision = "allow")
prefix_rule(pattern = ["gh","run","watch"], decision = "allow")
prefix_rule(pattern = ["gh","api","-X","GET"], decision = "allow")
prefix_rule(pattern = ["npm","run"], decision = "allow")
prefix_rule(pattern = ["npm","ls"], decision = "allow")
prefix_rule(pattern = ["npm","test"], decision = "allow")
prefix_rule(pattern = ["npx","tsc"], decision = "allow")
prefix_rule(pattern = ["npx","prettier"], decision = "allow")
prefix_rule(pattern = ["npx","eslint"], decision = "allow")
prefix_rule(pattern = ["npx","vitest"], decision = "allow")
prefix_rule(pattern = ["npx","jest"], decision = "allow")
prefix_rule(pattern = ["npx","@redocly/cli"], decision = "allow")
prefix_rule(pattern = ["npx","@stoplight/spectral-cli"], decision = "allow")
prefix_rule(pattern = ["git","push"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","create"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","merge"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","edit"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","close"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","reopen"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","review"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","comment"], decision = "prompt")
prefix_rule(pattern = ["gh","issue","create"], decision = "prompt")
prefix_rule(pattern = ["gh","issue","close"], decision = "prompt")
prefix_rule(pattern = ["gh","issue","comment"], decision = "prompt")
prefix_rule(pattern = ["gh","api","-X","POST"], decision = "prompt")
prefix_rule(pattern = ["gh","api","-X","PUT"], decision = "prompt")
prefix_rule(pattern = ["gh","api","-X","PATCH"], decision = "prompt")
prefix_rule(pattern = ["gh","api","-X","DELETE"], decision = "prompt")
prefix_rule(pattern = ["npm","publish"], decision = "prompt")
prefix_rule(pattern = ["npm","install"], decision = "prompt")
prefix_rule(pattern = ["npm","ci"], decision = "prompt")

# Claude の禁止設定のうち、引数前方一致で表現できるもの。
prefix_rule(pattern = ["git", "push", ["--force", "-f"], "origin", ["main", "master"]], decision = "forbidden", justification = "main/master への force push を禁止")
prefix_rule(pattern = ["rm", "-rf", ["/", "~", "$HOME", "/Users/arakitakashi"]], decision = "forbidden", justification = "ルートとホーム全体の再帰削除を禁止")
prefix_rule(pattern = ["sed", "-i"], decision = "forbidden", justification = "インプレース編集は差分を確認できる編集ツールを使用")
